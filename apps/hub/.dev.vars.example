DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-ascii-password
AUTH_MODE=basic
# Cloudflare Accessへ切り替える場合:
# AUTH_MODE=access
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=replace-with-access-application-aud
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
# 既定はclaude-haiku-5-5。別のモデルを試すときだけ設定する:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Multi-workspace keys only:
# ANTHROPIC_WORKSPACE_ID=wrkspc_replace-me
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-web-client-secret
# 32 random bytes encoded as base64url (43 characters without padding)
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
HUB_SERVICE_TOKEN=replace-with-a-random-32-byte-secret
SSO_SHARED_SECRET=replace-with-a-different-random-32-byte-secret
SESSION_TTL_DAYS=30

# Only for reading Knowledge/Finance from a separate Pages project (legacy). Leave unset: Hub calls /knowledge and /finance in-process.
# NAV_KNOWLEDGE_URL=https://your-knowledge-dashboard.pages.dev/
# NAV_FINANCIAL_URL=https://your-financial-dashboard.pages.dev/
NAV_TASK_BOARD_URL=

# Knowledge（/knowledge/ 配下）。pg_cronの生成・採点・embeddingバッチの合言葉と、意味検索のAPIキー。
REVIEW_BATCH_TOKEN=replace-with-yet-another-random-32-byte-secret
VOYAGE_API_KEY=pa-replace-me
