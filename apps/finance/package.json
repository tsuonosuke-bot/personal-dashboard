{
  "name": "financial-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && npx wrangler@4 pages dev dist",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --test-isolation=none tests/*.test.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "theme": "node scripts/build-dark-theme.mjs src/index.css",
    "theme:check": "node scripts/build-dark-theme.mjs --check src/index.css"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
